+++ b/tests/test_a4_form_constructor.py
@@ -0,0 +1,101 @@
+from __future__ import annotations
+
+from geoworkbench.forms.a4_layout import fit_form_to_a4, form_fits_a4
+from geoworkbench.forms.codec import form_from_dict, form_to_dict
+from geoworkbench.forms.models import (
+    FormAxisKind,
+    FormColumn,
+    FormDocument,
+    FormPageOrientation,
+    FormTrack,
+)
+from geoworkbench.tablet.models import TrackKind
+from geoworkbench.ui.form_create_dialog import FormCreateDialog
+from geoworkbench.ui.form_structure_editor_dialog import FormStructureEditorDialog
+from geoworkbench.forms.repository import FormRepository
+
+
+def _wide_form() -> FormDocument:
+    return FormDocument(
+        form_id="wide-a4-test",
+        name="Wide A4",
+        axis_kind=FormAxisKind.DEPTH,
+        preferred_page_orientation=FormPageOrientation.PORTRAIT,
+        columns=[
+            FormColumn.create(
+                "Глубина",
+                width=120,
+                tracks=[FormTrack.create("Глубина", TrackKind.DEPTH)],
+            ),
+            FormColumn.create(
+                "Литология",
+                width=180,
+                tracks=[FormTrack.create("Литология", TrackKind.LITHOLOGY)],
+            ),
+            FormColumn.create(
+                "Газовые параметры",
+                width=520,
+                tracks=[FormTrack.create("Газовые параметры", TrackKind.CURVE)],
+            ),
+        ],
+    )
+
+
+def test_form_orientation_round_trips_and_old_payload_defaults_to_portrait() -> None:
+    form = FormDocument.create(
+        "Landscape",
+        FormAxisKind.DEPTH,
+        preferred_page_orientation=FormPageOrientation.LANDSCAPE,
+    )
+    payload = form_to_dict(form)
+    assert payload["preferred_page_orientation"] == "landscape"
+    assert form_from_dict(payload).preferred_page_orientation is FormPageOrientation.LANDSCAPE
+
+    payload.pop("preferred_page_orientation")
+    payload["schema_version"] = 12
+    assert form_from_dict(payload).preferred_page_orientation is FormPageOrientation.PORTRAIT
+
+
+def test_auto_fit_respects_a4_capacity_and_compact_minimums() -> None:
+    form = _wide_form()
+    assert not form_fits_a4(form)
+
+    result = fit_form_to_a4(form, FormPageOrientation.PORTRAIT)
+
+    assert result.changed
+    assert form_fits_a4(form)
+    assert result.fitted_width_px <= result.capacity_px
+    assert form.columns[0].width >= 48
+    assert form.columns[1].width >= 48
+    assert form.columns[2].width >= 80
+    assert form.columns[0].title_orientation == "vertical_bottom_to_top"
+    assert form.columns[1].title_orientation == "vertical_bottom_to_top"
+
+
+def test_create_dialog_exposes_a4_orientation(qapp) -> None:
+    dialog = FormCreateDialog([], language="ru")
+    index = dialog.page_orientation_combo.findData("landscape")
+    dialog.page_orientation_combo.setCurrentIndex(index)
+    dialog.name_input.setText("Новая форма")
+    dialog._accept()
+
+    assert dialog.page_orientation is FormPageOrientation.LANDSCAPE
+    dialog.close()
+
+
+def test_structure_editor_exposes_live_a4_target_and_auto_fit(
+    qapp, tmp_path, monkeypatch
+) -> None:
+    repository = FormRepository(tmp_path / "forms")
+    dialog = FormStructureEditorDialog(_wide_form(), repository, language="ru")
+
+    monkeypatch.setattr(
+        "geoworkbench.ui.form_structure_editor_dialog.QMessageBox.information",
+        lambda *_args, **_kwargs: None,
+    )
+    assert dialog.page_orientation_combo.currentData() == "portrait"
+    assert dialog.fit_a4_button.isEnabled()
+    dialog._fit_to_selected_a4()
+    assert form_fits_a4(dialog.editor.form)
+    assert not dialog.fit_a4_button.isEnabled()
+    dialog.close()
